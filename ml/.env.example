# По умолчанию настройки читаются из backend/.env, затем ml/.env.
# Переменные окружения имеют наивысший приоритет.
# Допускается и postgresql+asyncpg:// — сервис заменит драйвер на psycopg.
DATABASE_URL=postgresql+psycopg://anifolder:anifolder@localhost:5432/anifolder

# Опционально: parquet AniList; без переменной обучение только по данным сайта.
# ML_ANILIST_DATA_DIR=/absolute/path/to/ml/data/anilist/lists
# ML_ARTIFACT_DIR=/absolute/path/to/ml/artifacts/service
